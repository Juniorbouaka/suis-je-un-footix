# =====================================================================
#  Variables d'environnement de PRODUCTION
#  À saisir dans le tableau de bord de l'hébergeur, PAS dans un fichier
#  committé. Ce fichier n'est qu'un aide-mémoire.
# =====================================================================

NODE_ENV=production

# Le port est imposé par l'hébergeur : ne le fixe pas s'il fournit $PORT.
PORT=4000

# --- Secrets JWT : OBLIGATOIRE ---
# Génère-les avec « npm run secrets ». Le serveur REFUSE de démarrer en
# production si ces valeurs sont celles de la démo.
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Clé API Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
CLAUDE_ESCALATION_MODEL=claude-opus-4-8
CLAUDE_ESCALATION_BELOW=20

# Plafond de dépense : au-delà, le jeu bascule en mode secours au lieu de
# continuer à consommer. Ajuste-le selon ton budget et ta fréquentation.
DAILY_API_BUDGET=3000

# --- Base de données ---
# DOIT pointer vers un volume persistant, sinon tout est effacé à chaque
# redéploiement. Sur Railway et Fly.io, monte le volume sur /data.
DATABASE_FILE=/data/footix.db

# --- CORS ---
# Laisse VIDE : le front est servi par ce même serveur, donc aucune requête
# cross-origin. Ne remplis ce champ que si tu héberges le front ailleurs,
# avec l'URL exacte (ex. https://footix.fr).
CLIENT_ORIGIN=

# --- E-mails (mot de passe oublié) ---
# Sans clé, personne ne peut récupérer son compte : le lien part seulement
# dans les logs. Resend est gratuit jusqu'à 3000 e-mails par mois.
RESEND_API_KEY=
MAIL_FROM=Suis-je un footix ? <bonjour@ton-domaine.fr>

# URL publique : indispensable, c'est elle qui compose les liens des e-mails.
PUBLIC_URL=https://ton-domaine.up.railway.app

# --- Sauvegardes automatiques ---
# Une copie cohérente de la base au démarrage puis toutes les 24 h,
# écrite dans <volume>/backups. Les 7 dernières sont conservées.
BACKUP_KEEP=7
BACKUP_INTERVAL_MS=86400000

# --- Règles de jeu ---
MAX_ATTEMPTS=50
MAX_ATTEMPTS_PVP=25
TURN_MS=15000
MAX_MISSED_TURNS=3
