# --- Suis-je un footix ? — configuration serveur ---

# Port du serveur API/WebSocket
PORT=4000

# Origine autorisée pour CORS (le front Vite)
CLIENT_ORIGIN=http://localhost:5173

# Secrets JWT (CHANGEZ-LES en production !)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clé API Anthropic — si absente, un évaluateur local de secours est utilisé
# (le jeu reste jouable, mais les scores sont moins nuancés).
ANTHROPIC_API_KEY=

# Modèle utilisé pour l'évaluation sémantique
CLAUDE_MODEL=claude-opus-4-8

# Chemin de la base SQLite
DATABASE_FILE=./data/footix.db

# Si le petit modele ne reconnait pas un joueur (score tres bas), on repasse sur celui-ci
CLAUDE_ESCALATION_MODEL=claude-opus-4-8
CLAUDE_ESCALATION_BELOW=20

# --- E-mails (mot de passe oublie) ---
# Sans cle, le lien de reinitialisation est ecrit dans les logs du serveur :
# pratique en developpement, inutilisable en production.
# Cree un compte sur resend.com (gratuit jusqu'a 3000 e-mails/mois).
RESEND_API_KEY=
MAIL_FROM=Suis-je un footix ? <onboarding@resend.dev>

# URL publique du site, utilisee dans les liens envoyes par e-mail.
PUBLIC_URL=http://localhost:5173

# --- Sauvegardes automatiques ---
BACKUP_KEEP=7
BACKUP_INTERVAL_MS=86400000
