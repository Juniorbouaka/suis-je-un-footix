# --- Suis-je un footix ? — configuration serveur ---

# Port du serveur API/WebSocket
PORT=4000

# Origine autorisée pour CORS (le front Vite)
CLIENT_ORIGIN=http://localhost:5173

# Secrets JWT (CHANGEZ-LES en production !)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Clé API Anthropic — si absente, un évaluateur local de secours est utilisé
# (le jeu reste jouable, mais les scores sont moins nuancés).
ANTHROPIC_API_KEY=

# Modèle utilisé pour l'évaluation sémantique
CLAUDE_MODEL=claude-opus-4-8

# Chemin de la base SQLite
DATABASE_FILE=./data/footix.db

# Si le petit modele ne reconnait pas un joueur (score tres bas), on repasse sur celui-ci
CLAUDE_ESCALATION_MODEL=claude-opus-4-8
CLAUDE_ESCALATION_BELOW=20

# --- E-mails (mot de passe oublie) ---
# Sans cle, le lien de reinitialisation est ecrit dans les logs du serveur :
# pratique en developpement, inutilisable en production.
# Cree un compte sur resend.com (gratuit jusqu'a 3000 e-mails/mois).
RESEND_API_KEY=
MAIL_FROM=Suis-je un footix ? <onboarding@resend.dev>

# URL publique du site, utilisee dans les liens envoyes par e-mail.
PUBLIC_URL=http://localhost:5173

# --- Sauvegardes automatiques ---
BACKUP_KEEP=7
BACKUP_INTERVAL_MS=86400000

# --- Abonnement premium (PayPal) ---
# Tant que PAYPAL_CLIENT_ID est vide, le module premium reste inactif :
# personne ne peut s'abonner, et le jeu fonctionne normalement.
#
# 1. Cree une application sur developer.paypal.com/dashboard/applications
#    (onglet Sandbox pour les essais, Live pour la production).
# 2. Renseigne les identifiants ci-dessous, puis lance :
#       cd server && npm run paypal:setup
#    Le script cree les plans et affiche les identifiants a recopier.
# 3. Declare le webhook indique par le script et recopie son identifiant.
#
# Les environnements sandbox et live sont etanches : les plans crees dans
# l'un n'existent pas dans l'autre. Il faut donc rejouer l'etape 2 au
# passage en production.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_PLAN_MONTHLY=
PAYPAL_PLAN_YEARLY=

# Sans cet identifiant, TOUS les webhooks sont refuses : les renouvellements
# et les resiliations ne seraient jamais pris en compte.
PAYPAL_WEBHOOK_ID=

# Tarifs affiches. Ils doivent correspondre aux plans PayPal ci-dessus :
# c'est PayPal qui facture, ces valeurs ne servent qu'a l'affichage.
PREMIUM_PRICE_MONTHLY=2,99
PREMIUM_PRICE_YEARLY=19,99

# --- Dons ---
# Lien affiche dans le pied de page, ex. https://paypal.me/tonpseudo
# Vide = aucun lien. N'y mets JAMAIS une adresse e-mail : une adresse en
# clair sur une page publique est aspiree par les robots en quelques jours.
DONATE_URL=

# --- Publicite (Google AdSense) ---
# Identifiant editeur, format « ca-pub-0000000000000000 ».
# Vide = aucune publicite, aucun script tiers charge, aucun bandeau.
#
# Lu a l'EXECUTION : changer cette valeur suffit, sans recompiler le front.
# Sert aussi a generer /ads.txt, exige par AdSense.
ADS_CLIENT=
